rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function room(roomCode) {
      return get(/databases/$(database)/documents/rooms/$(roomCode)).data;
    }

    function isMember(roomCode) {
      return signedIn() && request.auth.uid in room(roomCode).members;
    }

    function isOwner(roomCode) {
      return signedIn() && room(roomCode).creatorUid == request.auth.uid;
    }

    function validName(value) {
      return value is string && value.size() >= 1 && value.size() <= 50;
    }

    // A quoted message that a reply points at: its id, its author and a short snippet.
    function validReply(reply) {
      return reply is map
        && reply.keys().hasOnly(['id', 'username', 'text'])
        && reply.id is string && reply.id.size() <= 100
        && reply.username is string && reply.username.size() <= 50
        && reply.text is string && reply.text.size() <= 200;
    }

    // User profiles: only the owner can read or write their own profile.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'email'])
        && validName(request.resource.data.firstName)
        && validName(request.resource.data.lastName)
        && request.resource.data.email is string;
      allow delete: if false;
    }

    match /rooms/{roomCode} {
      // The room code is the secret: rooms can be fetched by code but never listed.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['roomCode', 'creatorUid', 'roomOpen', 'members', 'temporary', 'timestamp'])
        && roomCode.matches('[A-Z0-9]{6}')
        && request.resource.data.roomCode == roomCode
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.roomOpen == true
        && request.resource.data.temporary is bool
        && request.resource.data.timestamp == request.time
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && validName(request.resource.data.members[request.auth.uid]);

      allow update: if signedIn() && (
        // Owner closes the room.
        (resource.data.creatorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roomOpen']))
        ||
        // Any signed-in user joins an open room by adding only their own uid.
        (resource.data.roomOpen == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members.diff(resource.data.members).addedKeys().hasOnly([request.auth.uid])
          // hasOnly is also true for an empty set, so require a real addition: renaming yourself is not joining.
          && request.resource.data.members.diff(resource.data.members).addedKeys().size() == 1
          && validName(request.resource.data.members[request.auth.uid]))
        ||
        // A member (not the owner) leaves by removing only their own uid.
        (resource.data.creatorUid != request.auth.uid
          && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]))
      );

      allow delete: if signedIn() && resource.data.creatorUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isMember(roomCode);

        allow create: if isMember(roomCode)
          && room(roomCode).roomOpen == true
          && request.resource.data.keys().hasOnly(['uid', 'username', 'messageText', 'timestamp', 'replyTo'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username == room(roomCode).members[request.auth.uid]
          && request.resource.data.messageText is string
          && request.resource.data.messageText.size() >= 1
          && request.resource.data.messageText.size() <= 2000
          && request.resource.data.timestamp == request.time
          && (!('replyTo' in request.resource.data) || validReply(request.resource.data.replyTo));

        // Messages are never rewritten wholesale. Exactly three kinds of change are allowed.
        allow update: if isMember(roomCode) && (
          // The author edits their own message while the room is open.
          (room(roomCode).roomOpen == true
            && resource.data.uid == request.auth.uid
            && resource.data.get('deleted', false) != true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messageText', 'edited'])
            && request.resource.data.edited == true
            && request.resource.data.messageText is string
            && request.resource.data.messageText.size() >= 1
            && request.resource.data.messageText.size() <= 2000)
          ||
          // The author or the room owner removes a message. The document stays (so replies to it
          // still resolve) but its text is cleared.
          ((resource.data.uid == request.auth.uid || isOwner(roomCode))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'messageText'])
            && request.resource.data.deleted == true
            && request.resource.data.messageText == '')
          ||
          // Any member reacts while the room is open. Only the reactions field changes, and only
          // the supported emoji are accepted. (Rules cannot check that a member only touches their
          // own uid inside the lists.)
          (room(roomCode).roomOpen == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions is map
            && request.resource.data.reactions.keys().hasOnly(['👍', '😂', '😮', '😢', '🙏']))
        );

        allow delete: if isOwner(roomCode);
      }

      // Presence docs are keyed by uid so a user can only write their own.
      match /presence/{presenceId} {
        allow read: if isMember(roomCode);

        allow create, update: if isMember(roomCode)
          && presenceId == request.auth.uid
          && request.resource.data.keys().hasOnly(['username', 'isPresent', 'lastSeen'])
          && request.resource.data.username == room(roomCode).members[request.auth.uid]
          && request.resource.data.isPresent is bool
          && request.resource.data.lastSeen == request.time;

        allow delete: if signedIn() && (presenceId == request.auth.uid || isOwner(roomCode));
      }
    }
  }
}
